# Frontend (Vite / Render Static Site)
VITE_API_BASE_URL=https://api.truckfixr.com
VITE_APP_ID=truckfixr-render
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_OAUTH_PORTAL_URL=
VITE_OAUTH_SERVER_URL=
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_API_HOST=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
# Embeddable scheduler URL for the /fleet-review booking page — the 25-minute
# founder-led Fleet Maintenance Review (Calendly / Cal.com inline embed link,
# e.g. https://calendly.com/your-org/fleet-maintenance-review). The page passes
# name/email and a short summary as prefill params. When unset, qualified
# visitors see a "scheduling is being set up" fallback.
VITE_FLEET_REVIEW_SCHEDULER_URL=
# Optional hosted founder photo shown on the /fleet-review page (any HTTPS image
# URL). When unset, an initials avatar is shown instead.
VITE_FOUNDER_PHOTO_URL=

# ── Marketing analytics (public website only) ────────────────────────────────
# Cookieless, banner-free marketing analytics for the PUBLIC site. GA4 loads only
# in production, only on public marketing pages, runs WITHOUT cookies or on-device
# storage, and is suppressed for internal traffic, opted-out visitors, and any
# GPC/DNT signal. Never used on the signed-in app. Leave blank to disable GA4
# entirely — the site, builds, and booking keep working.
#
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX). When absent or
# malformed, GA4 is safely disabled (a dev-only console warning is emitted).
VITE_GA4_MEASUREMENT_ID=
# Optional: enable the sanitized analytics debug logger in non-production builds.
# When "true", events are logged to the console and NEVER sent to GA4.
VITE_ANALYTICS_DEBUG=
# Optional: force-enable marketing analytics outside production for local testing
# with a real ID. Off by default; analytics normally runs in production only.
VITE_ANALYTICS_FORCE_ENABLE=

# Backend (Node / Render Web Service)
APP_BASE_URL=
JWT_SECRET=
DATABASE_URL=
# Production should run reviewed Drizzle migrations before startup.
# Set true only for a controlled emergency schema-repair startup.
ALLOW_RUNTIME_SCHEMA_REPAIR=false
OAUTH_SERVER_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NHTSA_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
FLEET_MANAGER_EMAIL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
# Diagnosis workflow models routed through OpenRouter
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
DEFAULT_CLASSIFICATION_MODEL=deepseek/deepseek-v4-flash
DEFAULT_DIAGNOSIS_MODEL=deepseek/deepseek-v4-flash
LOW_COST_CLARIFICATION_MODEL=deepseek/deepseek-v4-flash
ADVANCED_DIAGNOSIS_MODEL=openai/gpt-4.1-mini
SAFETY_CRITICAL_MODEL=openai/gpt-4.1-mini
COMPLEX_FAULT_CODE_MODEL=google/gemini-2.5-flash
JSON_REPAIR_MODEL=openai/gpt-4.1-mini
FALLBACK_MODEL_1=google/gemini-2.5-flash
FALLBACK_MODEL_2=openai/gpt-4.1-mini
ADMIN_COMPARISON_MODEL=openai/gpt-4.1-mini
AI_COST_CEILING_MONTHLY_USD=
DIAGNOSIS_DISABLE_OPENAI=false
DIAGNOSIS_DISABLE_GEMINI=false
DIAGNOSIS_DISABLE_ANTHROPIC=false
GROQ_API_KEY=
GROQ_MODEL=
# VIN OCR only (server/services/ocr.ts). Kept separate from GROQ_MODEL above so switching
# the VIN OCR vision model never changes unrelated text-only diagnosis/classification
# features. Defaults to qwen/qwen3.6-27b (Groq's free-tier Qwen vision preview model) if unset.
# Free-tier availability/rate limits are an external Groq constraint, not guaranteed permanently.
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Optional: pins a specific OpenRouter multimodal model as a VIN OCR fallback. OpenRouter is
# otherwise treated as image-incapable (see aiOrchestrator.ts isImageCapableModel) since it can
# proxy both vision and text-only models depending on which one is configured. Leave unset to
# skip OpenRouter in the VIN OCR fallback chain.
OPENROUTER_VISION_MODEL=
# VIN OCR diagnostic logging only (server/services/ocr.ts) — provider/model used, ROI
# dimensions/byte size, raw model response, parsed candidate. Never logs image data. Opt-in.
ENABLE_VIN_OCR_DIAGNOSTICS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DIAGNOSTIC_CONFIDENCE_THRESHOLD=80
DIAGNOSTIC_MAX_CLARIFICATIONS=3
DIAGNOSTIC_LLM_RETRY_COUNT=2
DIAGNOSTIC_NEW_CAUSE_MIN_CONFIDENCE=62
DIAGNOSTIC_TIMEOUT_MS=18000
DIAGNOSTIC_INTAKE_MAX_TOKENS=320
DIAGNOSTIC_REVIEW_MAX_TOKENS=380
DIAGNOSIS_MAX_TOKENS=900
SIMPLE_TADIS_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_STRIPE_DIAGNOSTICS_ENDPOINT=false
STRIPE_PRICE_OWNER_OPERATOR_MONTHLY=
STRIPE_PRICE_OWNER_OPERATOR_ANNUAL=
STRIPE_PRICE_SMALL_FLEET_MONTHLY=
STRIPE_PRICE_SMALL_FLEET_ANNUAL=
STRIPE_PRICE_FLEET_GROWTH_MONTHLY=
STRIPE_PRICE_FLEET_GROWTH_ANNUAL=
STRIPE_PRICE_FLEET_PRO_MONTHLY=
STRIPE_PRICE_FLEET_PRO_ANNUAL=
# Stripe price envs may be a direct `price_...` id or a lookup key such as
# `truckfixr_owner_operator_monthly_cad` / `truckfixr_small_fleet_monthly_cad`.
STRIPE_PRICE_FLEET_PILOT_30_DAY=
STRIPE_PRICE_EXTRA_TRAILER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_FLEET_MONTHLY=
ADMIN_EMAILS=
SALES_NOTIFICATION_EMAIL=
